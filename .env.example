# Copy to .env and fill in. Never commit .env.

# Postgres. Local: scripts/dev-db.sh prints this. Prod: Neon *pooled* URL (…-pooler…/?sslmode=require)
DATABASE_URL=postgresql://gcc@localhost:5444/gcc

# LLM — any OpenAI-compatible chat-completions API. Leave LLM_API_KEY empty to
# run on the deterministic fast path only.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_S=20

# Shared secret Agora ConvoAI sends as `Authorization: Bearer …` to /v1/chat/completions
CUSTOM_LLM_TOKEN=

# Media: local folder in dev; public base URL (object storage) in prod
MEDIA_DIR=Complaints/Images
MEDIA_BASE_URL=

# Agora / Murf (M7, configured in the ConvoAI join; not used by the brain itself)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
MURF_API_KEY=

LOG_LEVEL=INFO
