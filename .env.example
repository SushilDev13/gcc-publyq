# Copy to .env and fill in. Never commit .env.

# Postgres. Local: scripts/dev-db.sh prints this. Prod: Neon *pooled* URL (…-pooler…/?sslmode=require)
DATABASE_URL=postgresql://gcc@localhost:5444/gcc

# Claude (Anthropic API) answers and investigates. Without a key the app falls
# back to the deterministic router.
ANTHROPIC_API_KEY=          # CLAUDE_API also accepted
# Only if the key is not scoped to a workspace (Console > Settings > Workspaces > ID):
ANTHROPIC_WORKSPACE_ID=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low

# Telegram bot (@BotFather) + the ward group's chat id (negative number)
BOT_TOKEN=
GROUP_CHAT_ID=

# Shared secret Agora ConvoAI sends as `Authorization: Bearer …` to /v1/chat/completions.
# Required: without it that endpoint is off. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
CUSTOM_LLM_TOKEN=

# Media: local folder in dev; public base URL (object storage) in prod
MEDIA_DIR=Complaints/Images
MEDIA_BASE_URL=

# Agora ConvoAI voice calls (agora project env, Default Project)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Murf Falcon TTS, used by the ConvoAI agent
MURF_API_KEY=
MURF_VOICE_ID=en-IN-anisha
MURF_LOCALE=en-IN
# Public https base URL of this backend (Agora's cloud calls PUBLIC_BASE_URL/v1/chat/completions)
PUBLIC_BASE_URL=

LOG_LEVEL=INFO

# Browser origins allowed to call the API cross-origin (comma-separated); the app itself is same-origin
CORS_ORIGINS=https://gcc.publyq.in
